{
  "uid": "trackhub-observability",
  "title": "TrackHub · Observability and Canary",
  "tags": ["trackhub", "lab7"],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "10s",
  "time": {"from": "now-15m", "to": "now"},
  "panels": [
    {
      "id": 1,
      "title": "Requests per second",
      "type": "timeseries",
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "gridPos": {"x": 0, "y": 0, "w": 12, "h": 8},
      "fieldConfig": {"defaults": {"unit": "reqps"}, "overrides": []},
      "targets": [{"refId": "A", "expr": "sum(rate(trackhub_http_requests_total{namespace=\"trackhub\"}[1m]))", "legendFormat": "all pods"}]
    },
    {
      "id": 2,
      "title": "HTTP 5xx share",
      "type": "timeseries",
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "gridPos": {"x": 12, "y": 0, "w": 12, "h": 8},
      "fieldConfig": {"defaults": {"unit": "percentunit", "min": 0, "max": 1}, "overrides": []},
      "targets": [{"refId": "A", "expr": "(sum(rate(trackhub_http_requests_total{namespace=\"trackhub\",status=~\"5..\"}[1m])) or vector(0)) / clamp_min(sum(rate(trackhub_http_requests_total{namespace=\"trackhub\"}[1m])), 0.001)", "legendFormat": "5xx share"}]
    },
    {
      "id": 3,
      "title": "p95 request duration",
      "type": "timeseries",
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "gridPos": {"x": 0, "y": 8, "w": 12, "h": 8},
      "fieldConfig": {"defaults": {"unit": "s"}, "overrides": []},
      "targets": [{"refId": "A", "expr": "histogram_quantile(0.95, sum by (le) (rate(trackhub_http_request_duration_seconds_bucket{namespace=\"trackhub\"}[1m])))", "legendFormat": "p95"}]
    },
    {
      "id": 4,
      "title": "Pod CPU",
      "type": "timeseries",
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "gridPos": {"x": 12, "y": 8, "w": 12, "h": 8},
      "fieldConfig": {"defaults": {"unit": "cores"}, "overrides": []},
      "targets": [{"refId": "A", "expr": "sum by (pod) (rate(container_cpu_usage_seconds_total{namespace=\"trackhub\",pod=~\"trackhub-.*\",container=\"trackhub\"}[1m]))", "legendFormat": "{{pod}}"}]
    },
    {
      "id": 5,
      "title": "Pod memory",
      "type": "timeseries",
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "gridPos": {"x": 0, "y": 16, "w": 12, "h": 8},
      "fieldConfig": {"defaults": {"unit": "bytes"}, "overrides": []},
      "targets": [{"refId": "A", "expr": "sum by (pod) (container_memory_working_set_bytes{namespace=\"trackhub\",pod=~\"trackhub-.*\",container=\"trackhub\"})", "legendFormat": "{{pod}}"}]
    },
    {
      "id": 6,
      "title": "TrackHub JSON logs",
      "type": "logs",
      "datasource": {"type": "loki", "uid": "loki"},
      "gridPos": {"x": 12, "y": 16, "w": 12, "h": 8},
      "options": {"showTime": true, "showLabels": false, "wrapLogMessage": true, "sortOrder": "Descending"},
      "targets": [{"refId": "A", "expr": "{namespace=\"trackhub\",container=\"trackhub\"} | json"}]
    }
  ]
}
